# Lint/type-check tooling for the CI "lint" job.
# Compiled to lint.txt with hashes via: make pip-compile
#
# The runtime deps (mcp, pydantic) are included so mypy --strict can resolve
# the FastMCP and pydantic types rather than treating them as untyped.
# ruff/black are pinned to the exact versions the CI lint job uses so the
# check stays deterministic across uv recompiles.
# GHSA-84m7-p3x7-pcfv: mcp <1.30.0 and 2.0.x/2.1.x are affected.
mcp>=1.30.0,!=2.0.*,!=2.1.*,<3
pydantic>=2.9,<3
ruff==0.16.4
# CVE-2026-114134 affects black before 26.10.1.
black==26.10.1
mypy>=1.11,<3.0
# HTTP transport + OAuth 2.1 resource-server auth, and (evidence-pack)
# Ed25519 signing -- runtime deps imported by the http subpackage /
# signing module and exercised by the tests.
pyjwt[crypto]>=2.15.1,<3
httpx>=0.27,<1
starlette>=1.3.1,<2
uvicorn>=0.30,<1
cryptography>=50.0.0,<51
urllib3>=2.8.0
